# App
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-string
AUTH_TRUST_HOST=true

# Postgres
DATABASE_URL=postgresql://clientdeck:clientdeck@localhost:5432/clientdeck

# MinIO / S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=clientdeck
S3_ACCESS_KEY=clientdeck
S3_SECRET_KEY=clientdecksecret
S3_FORCE_PATH_STYLE=true
# Public origin used inside presigned URLs (browser must reach this)
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Optional SMTP. If unset, invite and password-reset links are shown in the UI to copy.
# When set, review requests, comments, change requests, and approvals are also emailed.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=ClientDeck <portal@agency.com>
